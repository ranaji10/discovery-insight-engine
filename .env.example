# IP Fabric connection (live mode)
IPF_URL=https://127.0.0.1:8443
IPF_TOKEN=your-api-token-here
IPF_VERIFY=false

# OpenRouter LLM
OPENROUTER_API_KEY=your-openrouter-key-here
OPENROUTER_MODEL=google/gemini-2.5-flash

# Data mode:
#   live     = read snapshots from the IP Fabric instance above
#   recorded = read demo_data/recorded/ (a JSON export recorded from a live snapshot; used by the hosted app)
DATA_MODE=live
